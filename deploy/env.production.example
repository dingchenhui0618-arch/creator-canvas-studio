# =============================================================================
# VisionQA Workbench —— 生产环境变量样例（不含任何真实密钥）
#
# 安装（systemd 从这里读，不是 shell profile）：
#   sudo install -d -m 0750 -o root -g visionqa /etc/visionqa
#   sudo install -m 0640 -o root -g visionqa deploy/env.production.example /etc/visionqa/env
#   sudo editor /etc/visionqa/env        # 把你的真值填进去
#   sudo systemctl restart vq
#
# 文件名故意不带前导点：仓库 .gitignore 里有 .env 与 .env.* 两条规则，
# 叫 .env.production.example 会被静默忽略，叫 env.production.example 才能被提交与审阅。
# 但真实的 /etc/visionqa/env 里有密钥，绝不入仓、不进镜像、不发客户。
#
# 语法限制（systemd EnvironmentFile 不是 shell）：
#   * 一行一个 KEY=VALUE，不要写 export
#   * 不要加引号，不要写行尾注释（# 之后的内容不会被当成注释）
#   * 不展开 $OTHER_VAR，也不支持花括号形式的环境变量引用
#   * 值里必须出现空格时，整行用双引号包起来——本文件里没有这种键
# =============================================================================


# -----------------------------------------------------------------------------
# 一、进程与端口
# -----------------------------------------------------------------------------

# 监听端口。注意键名是 API_PORT：代码里没有 VQ_PORT 这个键（server/config.mjs 实测）。
# 生产保持 8787，反代指向同一个值。
API_PORT=8787

# 监听地址不在这里配：server/index.mjs 写死 listen(config.port, '127.0.0.1')。
# 这是有意为之——Node 只对回环暴露，公网流量一律经过 Caddy/nginx 反代。
# 不要为了「省一层」去改代码让它监听 0.0.0.0。

# 数据目录：templates.json / flows.json / agents.json / runs.json、frames/、
# jobs/ 以及账号库 auth.db 全部落在这里。
# 生产建议放在独立数据盘挂载点，而不是代码目录（发布时整目录替换会连数据一起换掉）。
# 不设置时默认是 <应用根>/data。
DATA_DIR=/var/lib/visionqa/data

# Node 堆上限。vq.service 的 ExecStart 已经带了 --max-old-space-size=1536，
# 这里再写会叠加成两个参数、以后者为准，容易看错。默认注释掉，二选一。
# NODE_OPTIONS=--max-old-space-size=1536


# -----------------------------------------------------------------------------
# 二、账号体系（server/config.mjs 的 config.auth）
#    会话 cookie 名固定为 vq_session，不开放配置
#
# 这一节的四个开关，代码默认值全在「不安全」那一侧，不显式写出来就等于没开：
#   VQ_REQUIRE_AUTH    仅 =1 时鉴权        （不写 = 全站 /api/* 不需要登录）
#   VQ_SECURE_COOKIES  仅 =1 时 cookie 带 Secure（不写 = cookie 可在 http 明文传输）
#   VQ_REGISTRATION    仅 =0 时关闭自助注册（不写 = 任何人都能注册）
#   VQ_SEED_PASSWORD   留空则不 seed 任何账号（部署后加人用 npm run adduser）
# 生产请保持下面写好的值，不要留空、不要整行删掉。
# -----------------------------------------------------------------------------

# =1：除 /api/auth/*、/api/health、/api/version 之外，所有 /api/* 都要求已登录。
# 生产必须 1。这是「能不能对外」的总开关，0 等于全站接口裸奔。
VQ_REQUIRE_AUTH=1

# =1：会话 cookie 带 Secure 属性，浏览器只在 HTTPS 下回传。
# 生产必须 1。设 0 只用于本机 http 调试，否则 Secure 与 http 混用会「登录成功但立刻掉线」。
VQ_SECURE_COOKIES=1

# 部署引导账号：库里没有这个邮箱时建一条普通账号，只为「部署完能登录」。
# 它不是演示入口——/api/auth/config 不再下发任何口令，界面上也没有演示标识。
# 留空则不建；之后的账号用 npm run adduser -- --email … --password … 加。
# VQ_SEED_EMAIL=
# VQ_SEED_PASSWORD=
# VQ_SEED_ACCOUNT=1

# =0：关闭自助注册（只允许已有账号登录）；=1：允许自助注册。
# 先 0。要放号时改 1 并重启服务，开放期间盯住注册接口日志。
VQ_REGISTRATION=0

# 会话有效期（天）：不勾「记住我」用 VQ_SESSION_DAYS，勾了用 VQ_REMEMBER_DAYS。
# 默认 7 / 30。内测阶段保持默认即可，别为了省事拉到 365。
VQ_SESSION_DAYS=7
VQ_REMEMBER_DAYS=30


# -----------------------------------------------------------------------------
# 三、视觉模型（server/config.mjs、server/llm.mjs、server/vision.mjs）
#
# 重要：VISION_API_KEY 为空时，config.mjs 的 readLocalToken() 会回落到读
# ~/.codex/auth.json（开发机上的个人凭证）。生产用 vq.service 的 ProtectHome=true
# 把这条回落路径掐掉，所以这里必须显式给值——漏配会直接报「未配置模型凭证」，
# 而不会静默借用别人的 token。
# -----------------------------------------------------------------------------

# 模型网关的 key。只写进 /etc/visionqa/env（0640 root:visionqa），不要写进任何明文模板
VISION_API_KEY=<在这里填生产 key>

# OpenAI 兼容端点。必须是生产可达的地址：
# 默认值 http://127.0.0.1:10100/v1 是开发机上的本地模型代理，生产机没有它。
VISION_BASE_URL=https://<你的模型网关域名>/v1

# 主力模型名，与网关里开通的模型一致
VISION_MODEL=<主力模型名>

# 降级链：主力失败/超时后按顺序尝试，逗号分隔，不要有空格
VISION_FALLBACKS=<备选模型1>,<备选模型2>

# 单次调用超时（毫秒）。视觉评审实测 60–85s，长视频抽帧分析会到 150s 以上，
# 默认 300000 已经是偏保守的值，不要调小——调小只会把正常的长任务判成超时。
VISION_TIMEOUT_MS=300000


# -----------------------------------------------------------------------------
# 四、红狐（爆款雷达的数据源，全站唯一的按次计费外部接口）
# -----------------------------------------------------------------------------

# 留空时 /api/search 返回示例数据，界面会明确标注「示例数据」，不会伪装成真实平台数据。
REDFOX_API_KEY=<红狐后台的 key>
REDFOX_BASE_URL=https://redfox.hk

# 搜索结果缓存时长（毫秒）。红狐按次计费，且有频控（抖音 10 次/秒、小红书 20 次/秒），
# 默认 300000（5 分钟）已经把同关键词的重复搜索省掉；调小会直接变成费用。
REDFOX_CACHE_TTL_MS=300000


# -----------------------------------------------------------------------------
# 五、上传与抽帧上限
# -----------------------------------------------------------------------------

# 单条视频体积上限（MB）。反代侧的请求体上限（Caddy request_body / nginx
# client_max_body_size，样例里是 200MB）必须 >= 这个值，否则大视频在反代层就被 413。
MAX_VIDEO_MB=160

# 每条视频最多抽多少帧。实测 22KB/张，18 帧约 0.4MB；调大只增加视觉调用成本与耗时。
MAX_FRAMES=18


# -----------------------------------------------------------------------------
# 六、BD Canvas（Source-Available 独立进程，代码不在本仓库里）
#
# 这三个值会被浏览器直接用到：画布页的 iframe 就是 src=BDC_WEB_URL（见 CanvasPage.tsx），
# 所以对外部署时 BDC_WEB_URL 必须换成客户浏览器能访问的地址（如 https://bdc.example.com，
# 由反代转到本机 6677），保持 127.0.0.1 的话客户只会看到打不开的 iframe。
# BDC_ADMIN_URL / BDC_API_URL 只给服务端探活用，保持 127.0.0.1 即可，不要对外。
# 这两个端口都只监听 127.0.0.1。
# 许可证禁止再分发它的源码或修改版：不要把它打进镜像、安装包，也不要发给客户。
# -----------------------------------------------------------------------------
# 本地开发/内网演示保持 http://127.0.0.1:6677；对外部署必须换成下面这种可访问的地址。
BDC_WEB_URL=https://bdc.example.com
BDC_ADMIN_URL=http://127.0.0.1:5313
BDC_API_URL=http://127.0.0.1:5312


# -----------------------------------------------------------------------------
# 七、外部视觉评审服务（server/review.mjs，可选）
# -----------------------------------------------------------------------------

# 有独立评审服务时才填；没有就整行删掉，代码会回落到本地实现。
# VISIONQA_SERVICE_URL=http://127.0.0.1:6300


# -----------------------------------------------------------------------------
# 八、积分单价与并发（server/config.mjs 的 config.credits，全部可选）
#
# 不写就用代码里的默认值；写了才覆盖。单价是内部积分，不是钱；
# 充值通道与支付档位仍未接入（GET /api/billing/overview 返回 enabled:false）。
# -----------------------------------------------------------------------------
# VQ_CREDIT_WELCOME=100
# VQ_CREDIT_SEARCH=2
# VQ_CREDIT_REPLICATE=10
# VQ_CREDIT_REVIEW=5
# VQ_CREDIT_CHAT=1
# 画布整条流程跑一次（含模型调用）：先扣后跑，有节点失败整单退回
# VQ_CREDIT_FLOW_RUN=2

# 单账号并发上限：防止连点把上游配额一次打光
# VQ_CONCURRENCY_SEARCH=1
# VQ_CONCURRENCY_REPLICATE=2
# VQ_CONCURRENCY_REVIEW=1
# VQ_CONCURRENCY_CHAT=2
# VQ_CONCURRENCY_FLOW_RUN=1
