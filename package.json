{
  "name": "creator-canvas-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test \"test/*.test.mjs\"",
    "preview": "vite preview",
    "dev:api": "node server/index.mjs",
    "dev:all": "concurrently -k \"npm:dev:api\" \"npm:dev\"",
    "start": "node server/index.mjs",
    "adduser": "node --experimental-sqlite scripts/adduser.mjs",
    "migrate-account": "node --experimental-sqlite scripts/migrate-account.mjs",
    "test:redfox": "node scripts/test-redfox.mjs",
    "stress": "node scripts/stress.mjs",
    "mock:redfox": "node scripts/mock-redfox.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
