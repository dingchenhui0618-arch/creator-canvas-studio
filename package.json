{
  "name": "creator-canvas-studio",
  "private": true,
  "version": "0.9.86",
  "description": "VisionQA 桌面端：网页外壳 + 本地工作区（agent loop 在本机运行）",
  "productName": "VisionQA",
  "author": "Wavision",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "desktop": "electron .",
    "desktop:dev": "electron . --local",
    "desktop:icon": "electron scripts/make-icon.cjs",
    "desktop:dist": "electron-builder --win --x64",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --experimental-sqlite --experimental-strip-types --test \"test/*.test.mjs\"",
    "check:node": "node scripts/check-node.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "loadtest": "node scripts/loadtest.mjs",
    "preview": "vite preview",
    "dev:api": "node server/index.mjs",
    "dev:all": "concurrently -k \"npm:dev:api\" \"npm:dev\"",
    "start": "node server/index.mjs",
    "adduser": "node --experimental-sqlite scripts/adduser.mjs",
    "migrate-account": "node --experimental-sqlite scripts/migrate-account.mjs",
    "test:redfox": "node scripts/test-redfox.mjs",
    "stress": "node scripts/stress.mjs",
    "mock:redfox": "node scripts/mock-redfox.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^40.10.6",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
