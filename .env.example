# 复制成 .env 后填入真实值；.env 已在 .gitignore 里
REDFOX_API_KEY=
# REDFOX_BASE_URL=https://redfox.hk
# VISION_BASE_URL=http://127.0.0.1:10100/v1
# VISION_MODEL=gpt-6.1-sol
# MAX_FRAMES=18

# ---- 账号体系（server/auth.mjs）----
# 生产必须打开：除 /api/auth/*、/api/health、/api/version 外，所有 API 都要登录
# VQ_REQUIRE_AUTH=1
# 生产必须打开（走 HTTPS 时给会话 cookie 加 Secure）
# VQ_SECURE_COOKIES=1
# 生产必须关掉：关掉后不再 seed 演示账号
# VQ_DEMO_ACCOUNT=0
# 演示账号（仅本地评审用，生产关掉演示账号后这两项不生效）
# VQ_DEMO_EMAIL=
# VQ_DEMO_PASSWORD=
# 自助注册开关，=0 关闭（内部系统建议关闭，由管理员建号）
# VQ_REGISTRATION=0
# 会话有效期（天）与勾选「记住我」后的有效期（天）
# VQ_SESSION_DAYS=7
# VQ_REMEMBER_DAYS=30
