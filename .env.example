# 复制成 .env 后填入真实值；.env 与 deploy/env.applied 都在 .gitignore 里
REDFOX_API_KEY=
# REDFOX_BASE_URL=https://redfox.hk
# MAX_FRAMES=18
# MAX_VIDEO_MB=160

# ---- 模型（OpenAI 兼容；文本与多模态分开配）----
# 官方 DeepSeek：deepseek-flash 的 input_modalities = text + image，聊天和看图共用一个模型；
# deepseek-v4-pro 只吃文本，只能当文本 fallback。
# VISION_BASE_URL=https://api.deepseek.com/v1
# VISION_API_KEY=
# LLM_MODEL=deepseek-flash
# LLM_FALLBACKS=deepseek-v4-pro
# VISION_MODEL=deepseek-flash
# VISION_MODELS=deepseek-flash
# VISION_FALLBACKS=

# ---- 账号体系（server/auth.mjs）----
# 生产必须打开：除 /api/auth/*、/api/health、/api/version 外，所有 API 都要登录
# VQ_REQUIRE_AUTH=1
# 生产必须打开（走 HTTPS 时给会话 cookie 加 Secure）
# VQ_SECURE_COOKIES=1
# 部署引导账号：库里没有这个邮箱时建一条 kind='account' 的普通账号（口令不下发给任何访客）。
# 建完就从 .env 里删掉这两行，改口令用 npm run adduser。
# VQ_SEED_EMAIL=
# VQ_SEED_PASSWORD=
# 自助注册开关，=0 关闭（内部系统建议关闭，由管理员建号）
# VQ_REGISTRATION=0
# 邀请码：注册关闭时，持有效邀请码的人也能自助开号（后台「账号 → 邀请码」签发）。
# 码默认 1 次 / 7 天 / 100 积分；同一来源 24 小时最多开 3 个号。
# VQ_INVITE_CREDITS=100
# VQ_INVITE_DAYS=7
# VQ_INVITE_USES=1
# VQ_INVITE_IP_LIMIT=3
# 会话有效期（天）与勾选「记住我」后的有效期（天）
# VQ_SESSION_DAYS=7
# VQ_REMEMBER_DAYS=30

# ---- 平台生成通道（画布的出图 / 出视频；server/gateway.mjs）----
# 画布服务端用这个令牌调通道（Authorization: Bearer）。不配时整个通道 503，不会退化成匿名可用。
# VQ_GATEWAY_TOKEN=
# 额度开关：上游额度没开通时保持 0，生成请求回 503「生成能力暂未开放」，而不是让上游 402 以「生成失败」出现。
# 打开后是全局的：画布服务里的所有账号、出图与出视频一起生效。
# VQ_GATEWAY_OPEN=0

# ---- 远端算力（一键复刻的抽帧交给外部服务）----
# 填上 URL 就启用：解析 / 下载 / 探测 / 抽帧 全部交给该服务，本机不跑 ffmpeg
# 仓库里自带参考实现：node worker/video-worker.mjs（默认 127.0.0.1:8790）
# REPLICATE_REMOTE_URL=http://127.0.0.1:8790/replicate
# REPLICATE_REMOTE_TOKEN=
# REPLICATE_REMOTE_LABEL=remote-worker
# REPLICATE_REMOTE_TIMEOUT_MS=180000
